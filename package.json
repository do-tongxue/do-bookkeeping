{
  "name": "qingzhang-family-ledger",
  "version": "0.1.0",
  "description": "移动优先的个人与家庭记账工具，使用 Cloudflare Pages、D1 和 Workers AI。",
  "license": "MIT",
  "private": true,
  "keywords": [
    "bookkeeping",
    "family-ledger",
    "personal-finance",
    "nextjs",
    "cloudflare"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --workspaces=false --include=dev --include=optional --no-audit --no-fund",
    "dev": "vinext dev --port 5173",
    "build": "next build --webpack",
    "install:all": "node scripts/install.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "start": "node scripts/start-local.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "npm run test:api && npm run test:voice && npm run test:deploy:cloudflare",
    "test:api": "node --test server/api.test.mjs",
    "test:voice": "node --test lib/voice-draft-inference.test.mjs",
    "test:deploy:cloudflare": "node --test scripts/deploy-cloudflare.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.107.1"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
